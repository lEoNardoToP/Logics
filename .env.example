# Copy values into your deployment environment (never commit real values).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_database_user
DB_PASSWORD=replace_with_a_new_secret

SMTP_HOST=your.smtp.server
SMTP_PORT=465
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=replace_with_a_new_secret
SMTP_FROM_EMAIL=mail@example.com
SMTP_FROM_NAME=Logics

# Key for encrypting user ids in session tokens (random, at least 32 characters)
APP_ENCRYPTION_KEY=replace_with_a_new_secret
# Where new-chat-message notifications are sent
ADMIN_NOTIFY_EMAIL=admin@example.com
